# ─── Database ────────────────────────────────────────────────────────────────
# Neon or any Postgres-compatible connection string
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ─── Auth (server-only — NEVER prefix with NEXT_PUBLIC_) ─────────────────────
JWT_SECRET=change-me-to-32-random-bytes
JWT_REFRESH_SECRET=change-me-to-another-32-random-bytes
# Session cookie name
SESSION_COOKIE_NAME=gg_session

# ─── Rate Limiting (Upstash Redis) ───────────────────────────────────────────
# Required for production rate limiting on API routes
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here

# ─── Payments (server-only) ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
KLARNA_ACCOUNT_NUMBER=
KLARNA_ROUTING_NUMBER=

# ─── Public env vars (safe to expose to client) ──────────────────────────────
NEXT_PUBLIC_APP_URL=https://global-gateway-5enx4n7g4-admin-25521151s-projects.vercel.app
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# ─── KYC / Compliance ────────────────────────────────────────────────────────
KYC_PROVIDER_API_KEY=

# ─── Azure (for production infrastructure) ───────────────────────────────────
# See migration report for full Azure dependency list
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_STORAGE_CONNECTION_STRING=
