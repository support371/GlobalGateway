# Application
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-value

# Database (required for persistent application data)
DATABASE_URL=

# USPS REST APIs (required for live rates, tracking, and address verification)
# Create an application in the USPS Developer Portal and copy its OAuth credentials.
USPS_CLIENT_ID=
USPS_CLIENT_SECRET=

# Optional USPS overrides
# USPS_API_ENV=production
# USPS_API_BASE_URL=https://apis.usps.com
# USPS_OAUTH_URL=https://apis.usps.com/oauth2/v3/token
# USPS_REQUEST_TIMEOUT_MS=12000

# Shipito warehouse forwarding
# Keep manual mode active until Shipito confirms Business/API access.
SHIPITO_MODE=manual
SHIPITO_API_ENABLED=false
SHIPITO_ACCOUNT_NAME=Victoria Eleanor
SHIPITO_SUITE=BZA842
SHIPITO_WAREHOUSE_ADDRESS_1=444 Alaska Avenue
SHIPITO_WAREHOUSE_CITY=Torrance
SHIPITO_WAREHOUSE_STATE=CA
SHIPITO_WAREHOUSE_POSTAL_CODE=90503
SHIPITO_WAREHOUSE_COUNTRY=USA

# Reserved for approved Shipito for Business credentials. Do not expose these to the browser.
SHIPITO_API_KEY=
SHIPITO_API_SECRET=
